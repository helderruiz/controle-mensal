<xml xmlns="http://www.w3.org/1999/xhtml">
  <block type="component_event" id="whatsapp-webview-string-change" x="80" y="80">
    <mutation component_type="WebViewer" is_generic="false" instance_name="NavegadorWeb1" event_name="WebViewStringChange"></mutation>
    <field name="COMPONENT_SELECTOR">NavegadorWeb1</field>
    <statement name="DO">
      <block type="controls_if" id="whatsapp-check-uri">
        <value name="IF0">
          <block type="text_contains" id="whatsapp-uri-contains">
            <value name="TEXT">
              <block type="lexical_variable_get" id="whatsapp-event-value">
                <mutation><eventparam name="value"></eventparam></mutation>
                <field name="VAR">value</field>
              </block>
            </value>
            <value name="PIECE">
              <block type="text" id="whatsapp-scheme-text">
                <field name="TEXT">whatsapp://</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="component_set_get" id="whatsapp-set-action">
            <mutation component_type="ActivityStarter" set_or_get="set" property_name="Action" is_generic="false" instance_name="Activity_Starter1"></mutation>
            <field name="COMPONENT_SELECTOR">Activity_Starter1</field>
            <field name="PROP">Action</field>
            <value name="VALUE">
              <block type="text" id="whatsapp-action-view">
                <field name="TEXT">android.intent.action.VIEW</field>
              </block>
            </value>
            <next>
              <block type="component_set_get" id="whatsapp-set-data-uri">
                <mutation component_type="ActivityStarter" set_or_get="set" property_name="DataUri" is_generic="false" instance_name="Activity_Starter1"></mutation>
                <field name="COMPONENT_SELECTOR">Activity_Starter1</field>
                <field name="PROP">DataUri</field>
                <value name="VALUE">
                  <block type="lexical_variable_get" id="whatsapp-event-value-for-uri">
                    <mutation><eventparam name="value"></eventparam></mutation>
                    <field name="VAR">value</field>
                  </block>
                </value>
                <next>
                  <block type="component_method" id="whatsapp-start-activity">
                    <mutation component_type="ActivityStarter" method_name="StartActivity" is_generic="false" instance_name="Activity_Starter1"></mutation>
                    <field name="COMPONENT_SELECTOR">Activity_Starter1</field>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
  <yacodeblocks ya-version="247" language-version="34"></yacodeblocks>
</xml>